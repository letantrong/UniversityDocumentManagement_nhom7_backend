{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=MSI;Database=UniversityDocumentManagementDb_V2;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyForDevelopmentPhaseOnlyChangeInProduction2026!",
    "Issuer": "UCDMS_Backend",
    "Audience": "UCDMS_Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "FileStorageSettings": {
    "StoragePath": "D:\\UniversityDocumentManagement_Storage",
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [ ".pdf", ".docx", ".doc", ".xlsx", ".xls", ".png", ".jpg", ".jpeg" ]
  },
  "IntakeSettings": {
    "SessionExpiryMinutes": 15,
    "MaxFilesPerSession": 10
  }
}
